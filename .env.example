# Postgres connection string (local Postgres, Docker, or Railway's proxy URL for
# this environment). The schema targets Postgres, so this must be Postgres too.
DATABASE_URL="postgresql://user:password@localhost:5432/survivor_fantasy"

# --- Auth (Google sign-in) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (OAuth consent screen + "Web application" credential), with an authorized
# redirect URI of {NEXTAUTH_URL}/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Draft lock ---
# ISO timestamp after which draft picks can no longer be changed
# (e.g. season premiere). Leave unset to allow picks indefinitely.
# DRAFT_LOCK_AT="2026-09-24T20:00:00-07:00"

# --- Admin ---
# Comma-separated Google account emails allowed into /admin (episode stat
# entry, contestant status, team overrides).
ADMIN_EMAILS=""
